# Uygulama ayarlari (ortam degiskenleri)

# Zorunlu: MariaDB/MySQL baglantisi
DATABASE_DSN=burs:sifre@tcp(127.0.0.1:3306)/burs

# Sitenin adresi (baglanti uretiminde ve guvenli cerez kararinda kullanilir)
BASE_URL=https://burs.lafed.org.tr

# T.C. kimlik sifrelemesi ve imzalama anahtari: openssl rand -hex 32
# Bos birakilirsa DATA_DIR icinde otomatik uretilir (uretimde elle verin).
SECRET_KEY=

# Belgelerin ve anahtarin tutuldugu dizin
DATA_DIR=/data

# Dinlenecek adres
LAFED_ADDR=:8080

# Yukleme boyut siniri (MB)
MAX_UPLOAD_MB=8

# Ingress/proxy arkasindaysa gercek istemci IP'si icin true
TRUST_PROXY=true

# Ilk yonetici hesabi (yalnizca hic yonetici yokken kullanilir)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASS=

# Saat dilimi
TZ=Europe/Istanbul
